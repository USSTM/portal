{
  "name": "usstm-portal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @usstm/auth --filter @usstm/portal dev",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:deployment": "node --test tests/deployment/production-stack.test.mjs",
    "test:deployment:integration": "node --test tests/deployment/live-stack.integration.test.mjs",
    "test:integration": "pnpm -r --if-present test:integration",
    "db:up": "docker compose --env-file .env.local up -d postgres",
    "db:migrate": "pnpm --filter @usstm/portal db:migrate",
    "db:test:up": "docker compose --env-file .env.test up -d postgres-test",
    "db:test:migrate": "bash -c 'set -a && source .env.test && set +a && pnpm --filter @usstm/portal db:migrate'",
    "db:test:reset": "bash -c 'set -a && source .env.test && set +a && pnpm --filter @usstm/portal db:test:reset'",
    "build": "pnpm -r --if-present build",
    "deploy:production": "./deployment/deploy.sh",
    "ci": "pnpm format && pnpm lint && pnpm typecheck && pnpm db:migrate && pnpm test && pnpm test:integration && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "prettier": "3.9.5",
    "seroval": "1.5.5",
    "typescript-eslint": "8.64.0"
  }
}
