{
  "name": "@usstm/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev --port 3002",
    "build": "NODE_OPTIONS='--no-deprecation --max-old-space-size=8000' next build",
    "start": "NODE_OPTIONS=--no-deprecation next start --port 3002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "NODE_OPTIONS='--no-deprecation --no-experimental-strip-types' playwright test",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate": "NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "NODE_OPTIONS=--no-deprecation payload migrate:create",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "seed:faq": "tsx scripts/seed-faq.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@tailwindcss/postcss": "4.3.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "12.43.0",
    "graphql": "16.14.2",
    "hamburger-react": "2.5.2",
    "lucide-react": "0.577.0",
    "next": "15.4.11",
    "payload": "3.90.2",
    "postcss": "8.5.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.34.5",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.4.11",
    "jsdom": "28.1.0",
    "tsx": "4.23.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.10"
  }
