# Payload-owned database. Never point this at the portal database.
DATABASE_URI=postgresql://usstm_website:usstm_website@localhost:5432/usstm_website
# Used to sign Payload admin sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Public origin of this site. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3002
# Portal origin serving GET /api/v1/events. No trailing slash.
PORTAL_PUBLIC_URL=http://localhost:3000
PREVIEW_SECRET=
CRON_SECRET=
# S3-compatible media storage (Supabase storage, AWS S3, R2, ...)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=
