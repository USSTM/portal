# Public origin. Use a DNS name whose A/AAAA record points to the production host.
PORTAL_ADDRESS=portal.example.com
WEBSITE_ADDRESS=example.com

# PostgreSQL. URL-encode reserved characters in DATABASE_URL credentials.
DATABASE_NAME=usstm_portal
DATABASE_USER=usstm
DATABASE_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://usstm:replace-with-a-long-random-password@postgres:5432/usstm_portal

# Payload-owned website database on the same server. Created on first volume
# initialisation by deployment/postgres/init/01-website.sh.
WEBSITE_DATABASE_NAME=usstm_website
WEBSITE_DATABASE_USER=usstm_website
WEBSITE_DATABASE_PASSWORD=replace-with-a-different-long-random-password
WEBSITE_DATABASE_URI=postgresql://usstm_website:replace-with-a-different-long-random-password@postgres:5432/usstm_website

# Shared authentication service.
AUTH_SESSION_ISSUER=usstm-auth
AUTH_SESSION_KEY_ID=current
AUTH_SESSION_PRIVATE_JWK={"kty":"EC","crv":"P-256","d":"...","x":"...","y":"..."}
AUTH_CLIENTS=[{"audience":"portal","callbackPath":"/auth/callback","clientId":"google-client-id","clientSecret":"google-client-secret","cookieName":"__Host-portal-session","origin":"https://portal.example.com"}]

# Portal authentication and authorization.
PORTAL_AUTH_ISSUER=usstm-auth
PORTAL_AUTH_KEY_ID=current
PORTAL_AUTH_PUBLIC_JWK={"kty":"EC","crv":"P-256","x":"...","y":"..."}
PORTAL_SUPERUSER_EMAIL=admin@example.com

# Authenticated Contact page.
PORTAL_CONTACT_EMAIL=info@example.com
PORTAL_CONTACT_INSTAGRAM=https://www.instagram.com/example
PORTAL_CONTACT_WEBSITE=https://example.com
PORTAL_CONTACT_LINKTREE=https://linktr.ee/example

# Website (Payload CMS). Generate PAYLOAD_SECRET with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-secret
# S3-compatible media bucket (Supabase storage, AWS S3, R2, ...).
S3_BUCKET=usstm-website-media
S3_ENDPOINT=https://s3.example.com
S3_REGION=ca-central-1
S3_ACCESS_KEY_ID=replace-with-media-access-key
S3_SECRET_ACCESS_KEY=replace-with-media-secret-key

# Encrypted off-host backups. This example uses S3-compatible storage; restic also
# accepts its other remote repository schemes.
RESTIC_REPOSITORY=s3:https://s3.example.com/usstm-portal-production
RESTIC_PASSWORD=replace-with-an-independent-long-random-passphrase
AWS_ACCESS_KEY_ID=replace-with-backup-only-access-key
AWS_SECRET_ACCESS_KEY=replace-with-backup-only-secret-key
AWS_DEFAULT_REGION=ca-central-1
