#!/usr/bin/env bash
set -euo pipefail

required=(
  DATABASE_NAME
  DATABASE_PASSWORD
  DATABASE_USER
  RESTIC_PASSWORD
  RESTIC_REPOSITORY
  WEBSITE_DATABASE_NAME
)

for name in "${required[@]}"; do
  if [[ -z "${!name:-}" ]]; then
    printf '%s is required\n' "$name" >&2
    exit 1
  fi
done

export PGPASSWORD="$DATABASE_PASSWORD"

if ! restic snapshots --no-cache >/dev/null 2>&1; then
  restic init
fi

timestamp="$(date -u +%Y-%m-%dT%H-%M-%SZ)"

# database name -> snapshot tag
backup_database() {
  local database="$1" tag="$2"
  pg_dump \
    --dbname "$database" \
    --format custom \
    --host postgres \
    --no-acl \
    --no-owner \
    --username "$DATABASE_USER" |
    restic backup \
      --no-cache \
      --stdin \
      --stdin-filename "/${tag}-${timestamp}.dump" \
      --tag "$tag"
}

backup_database "$DATABASE_NAME" usstm-portal
backup_database "$WEBSITE_DATABASE_NAME" usstm-website
