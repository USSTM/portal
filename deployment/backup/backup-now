#!/usr/bin/env bash
set -euo pipefail

required=(
  DATABASE_NAME
  DATABASE_PASSWORD
  DATABASE_USER
  RESTIC_PASSWORD
  RESTIC_REPOSITORY
)

for name in "${required[@]}"; do
  if [[ -z "${!name:-}" ]]; then
    printf '%s is required\n' "$name" >&2
    exit 1
  fi
done

export PGPASSWORD="$DATABASE_PASSWORD"

if ! restic snapshots --no-cache >/dev/null 2>&1; then
  restic init
fi

timestamp="$(date -u +%Y-%m-%dT%H-%M-%SZ)"
pg_dump \
  --dbname "$DATABASE_NAME" \
  --format custom \
  --host postgres \
  --no-acl \
  --no-owner \
  --username "$DATABASE_USER" |
  restic backup \
    --no-cache \
    --stdin \
    --stdin-filename "/usstm-portal-${timestamp}.dump" \
    --tag usstm-portal
