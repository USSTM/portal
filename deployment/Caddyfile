{
	admin localhost:2019
	log {
		output stdout
		format json
	}
}

(common) {
	log {
		output stdout
		format filter {
			request>uri query {
				replace code REDACTED
				replace state REDACTED
			}
			wrap json
		}
	}

	# A request that has already passed through this Caddy instance carries
	# our own Via hop. Seeing it again means something upstream is looping
	# a request back to us instead of returning a response to the client.
	@loop header_regexp Via Caddy
	respond @loop "Proxy loop detected" 508

	header X-Request-ID {http.request.uuid}
	# Deferred (>) so these are the last word on the response, not stacked
	# on top of whatever the upstream already set.
	header {
		>Cross-Origin-Opener-Policy "same-origin"
		>Permissions-Policy "camera=(), geolocation=(), microphone=()"
		>Referrer-Policy "strict-origin-when-cross-origin"
		>Strict-Transport-Security "max-age=31536000; includeSubDomains"
		>X-Content-Type-Options "nosniff"
		>X-Frame-Options "DENY"
	}
}

{$PORTAL_ADDRESS} {
	import common

	header {
		>Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
	}
	request_body {
		max_size 1MB
	}

	@auth path /auth/*
	reverse_proxy @auth auth:3001 {
		header_up X-Request-ID {http.request.uuid}
		header_up X-Forwarded-Host {http.request.host}
		header_up X-Forwarded-Proto {http.request.scheme}
	}

	reverse_proxy portal:3000 {
		header_up X-Request-ID {http.request.uuid}
		header_up X-Forwarded-Host {http.request.host}
		header_up X-Forwarded-Proto {http.request.scheme}
	}
}

{$WEBSITE_ADDRESS} {
	import common

	# Payload serves media from the bucket through /api/media/file, so images
	# stay same-origin. frame-src covers the hosts the Embed block is used with.
	header {
		>Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; frame-src https://www.youtube.com https://www.google.com; img-src 'self' data: blob:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
	}
	# Admin media uploads.
	request_body {
		max_size 25MB
	}

	reverse_proxy website:3000 {
		header_up X-Request-ID {http.request.uuid}
		header_up X-Forwarded-Host {http.request.host}
		header_up X-Forwarded-Proto {http.request.scheme}
	}
}
